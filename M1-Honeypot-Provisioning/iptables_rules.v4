# ==============================================================================
# Linux Netfilter (iptables) Egress & Lateral Movement Containment
# Profile: Deception Node Strict DMZ Isolation
# ==============================================================================
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]

# 1. Loopback Traffic Allowance
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# 2. Allow Established & Related Sessions (Stateful Inspection)
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# 3. Administrative SSH Access (Strictly Restricted to Management IP)
-A INPUT -p tcp -s 10.0.0.2 --dport 22 -m conntrack --ctstate NEW -j ACCEPT

# 4. Cowrie Honeypot Ingress Listener (Port 2222)
-A INPUT -p tcp --dport 2222 -m conntrack --ctstate NEW -j ACCEPT

# 5. Egress Containment - Restrict DNS to Internal Resolver Only
-A OUTPUT -p udp --dport 53 -d 10.0.0.1 -j ACCEPT
-A OUTPUT -p tcp --dport 53 -d 10.0.0.1 -j ACCEPT

# 6. Egress Containment - Monitored Syslog / SIEM Alerting Forwarder
-A OUTPUT -p tcp --dport 514 -d 10.0.0.200 -j ACCEPT

# 7. Drop and Log All Other Egress Attempts (Prevent Pivoting & C2 Outbound)
-A OUTPUT -m limit --limit 5/min -j LOG --log-prefix "HONEYPOT-EGRESS-BLOCKED: " --log-level 4
-A OUTPUT -j DROP

COMMIT
